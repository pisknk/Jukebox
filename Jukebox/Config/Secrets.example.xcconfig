// Copy this file to Secrets.xcconfig (in this folder) and fill in your Last.fm API
// account details from https://www.last.fm/api/accounts. Secrets.xcconfig is ignored by git.
//
// GitHub Actions: add repository secrets LASTFM_API_KEY and LASTFM_API_SECRET and the
// build workflow will create Secrets.xcconfig for you.

LASTFM_API_KEY = your_api_key_here
LASTFM_API_SECRET = your_api_secret_here
